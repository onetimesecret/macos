# OTS Cache — example environment. Documents variable NAMES only, never values
# (docs/01 §8). Real credentials live in the macOS Keychain (docs/00 §10); the
# API token in particular must NEVER be written here.

# Onetime Secret API base URL for the optional share bridge.
OTS_API_BASE_URL=https://onetimesecret.com

# The customer external id — the HTTP Basic username (docs/00 §12). Not itself a
# secret, but leave it blank in the committed example.
OTS_EXTID=

# Optional custom share domain for concealed links.
OTS_SHARE_DOMAIN=

# NOTE: the API token (the Basic-auth password) has no variable here on purpose.
# It is stored in the Keychain under service "com.onetimesecret.otscache",
# keyed by OTS_EXTID.
