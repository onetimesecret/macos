# Rust
/target/
# tauri-panel is excluded from the Cargo workspace by construction
# (spikes/README.md), so its target/ isn't covered by the root's.
/spikes/tauri-panel/target/
# tauri-build regenerates these ACL/capability schemas on every build.
/spikes/tauri-panel/gen/
**/*.rs.bk

# Xcode / Swift (spikes, later the shell)
.build/
DerivedData/
*.xcuserstate
xcuserdata/
*.xcframework/
# Generated by scripts/build-core.sh — a build artifact, not source
/bindings/

# Signing material & local credentials — never commit
.env
.env.*
!.env.example
*.pem
*.p12
*.token
*.provisionprofile
secrets/

# macOS
.DS_Store
