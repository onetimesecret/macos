# Rust
/target/
**/*.rs.bk
__pycache__/
/tools/language-eval/output/

# Xcode / Swift (the shell)
.build/
DerivedData/
*.xcuserstate
xcuserdata/
*.xcframework/
# Generated by scripts/build-core.sh — a build artifact, not source
/bindings/
# Generated by scripts/package-app.sh: the assembled .app bundle
/dist/

# Signing material & local credentials — never commit
.env
.env.*
!.env.example
/scripts/local.env
*.pem
*.p12
*.token
*.provisionprofile
secrets/

# Session tooling — local workflow scripts, not source
/.claude/workflows/

# macOS
.DS_Store
*.txt
/.serena/

# Local notes: dated files at the repository root, and only there. The
# leading slash matters. Without it the rule also matched every ADR
# (docs/adr/NNNN-title.md) and every dated decision record, so a new
# one stayed out of git status and could be left out of a commit
# without anyone noticing.
/[0-9][0-9][0-9][0-9]*-*.md
