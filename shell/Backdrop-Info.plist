<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The background-surface form factor's identity sheet, consumed by
  scripts/build-backdrop.sh — the sibling of shell/Info.plist (which
  belongs to the panel app and is untouched by this target, ADR-0010).

  Its own bundle id, deliberately: TCC grants, screen-capture pickers,
  and LaunchServices key on the identifier, and the two form factors
  must be separately addressable citizens of the permission system —
  especially since both may run at once during the exploration.

  CFBundleVersion / CFBundleShortVersionString hold a placeholder; the
  build script stamps both from crates/ffi's CARGO_PKG_VERSION — the
  same source companion_version() is baked from.
-->
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>CompanionBackdrop</string>
	<key>CFBundleExecutable</key>
	<string>CompanionBackdrop</string>
	<key>CFBundleIdentifier</key>
	<string>com.onetimesecret.companion.backdrop</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>CompanionBackdrop</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>0.0.0</string>
	<key>CFBundleVersion</key>
	<string>0.0.0</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.utilities</string>
	<key>LSMinimumSystemVersion</key>
	<string>13.0</string>
	<!-- No LSUIElement, unlike the panel: the backdrop is a regular
	     app (Dock icon, ⌘Tab membership) by an argued amendment in the
	     feature spec — activation is one of its summon routes. -->
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>NSHumanReadableCopyright</key>
	<string>© Onetime Secret</string>
</dict>
</plist>
