<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  OnetimePad's identity sheet, consumed by scripts/package-app.sh. The
  panel sibling and its shell/Info.plist were archived (ADR-0014), so
  this is the one identity the shell ships.

  CFBundleName / CFBundleDisplayName, CFBundleExecutable, the target,
  and the .app filename all say OnetimePad, the product's name, and are
  free to change with it. The bundle id is not: it keys the Keychain
  service, the state directory, the keychain access group, and every
  TCC grant the app has been given, so it keeps the legacy
  com.onetimesecret.companion.backdrop string from the days when the
  target was named for its posture. Ids are infrastructure; names are
  paint.

  CFBundleShortVersionString is the product's own number and this file
  is where it lives: edit it here, by hand, when work a user can touch
  lands. It used to be stamped from crates/ffi's CARGO_PKG_VERSION,
  which made the number users see a fact about the Rust seam, so a
  release that changed every keystroke and no crate did not move it
  while two invisible seam changes did (issue #89). The core keeps its
  crate version and still speaks for itself through companion_version();
  the two numbers now move for their own reasons.

  CFBundleVersion holds a placeholder. The build script stamps it from
  the short version above plus the commit the bundle was built from, so
  "which build am I on" has a one-glance answer.
-->
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>OnetimePad</string>
	<key>CFBundleExecutable</key>
	<string>OnetimePad</string>
	<key>CFBundleIconFile</key>
	<string>AppIcon</string>
	<key>CFBundleIdentifier</key>
	<string>com.onetimesecret.companion.backdrop</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>OnetimePad</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>0.17.0</string>
	<key>CFBundleVersion</key>
	<string>0.0.0</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.utilities</string>
	<key>LSMinimumSystemVersion</key>
	<string>13.0</string>
	<!-- No LSUIElement, unlike the panel: the backdrop is a regular
	     app (Dock icon, ⌘Tab membership) by an argued amendment in the
	     feature spec — activation is one of its summon routes. -->
	<key>NSHighResolutionCapable</key>
	<true/>
	<!-- Matches the panel: opting in is what makes PageModel's
	     SuddenTerminationLatch the real gate on the logout kill, rather
	     than leaving the ADR-0012 clause satisfied by the accident of
	     never having opted in. -->
	<key>NSSupportsSuddenTermination</key>
	<true/>
	<key>NSHumanReadableCopyright</key>
	<string>© Onetime Secret</string>
</dict>
</plist>
