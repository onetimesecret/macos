{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "tauri-panel",
  "version": "0.1.0",
  "identifier": "com.onetimesecret.companion.spike.tauri-panel",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "panel",
        "url": "index.html",
        "width": 320,
        "height": 480,
        "visible": false,
        "focus": false,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "skipTaskbar": true,
        "resizable": false,
        "alwaysOnTop": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false
  }
}
